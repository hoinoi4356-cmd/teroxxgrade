# ============================================================
# Discord бот тикетів — discord-ticket-bot/ticket-bot.js
# Скопіюй цей файл у .env і заповни своїми значеннями.
# НІКОЛИ не публікуй .env у GitHub (він додано у .gitignore).
# ============================================================

# Токен бота Discord: Discord Developer Portal → твій додаток → Bot → "Reset token"
DISCORD_BOT_TOKEN=ТВІЙ_ТОКЕН_ТУТ

# ID сервера (Discord Guild), де будуть тикети.
# У Discord увімкни Режим розробника (Налаштування → Розширений) → копіюй ID сервера.
DISCORD_GUILD_ID=123456789012345678

# ID ролі персоналу (модератори / адміни), які бачать усі тикети і recebуть згадку.
STAFF_ROLE_ID=123456789012345678

# Название категории для тикетов (создаётся автоматически, если её нет).
TICKET_CATEGORY_NAME=Тикеты / Tickets

# RCON WebSocket сервера Rust (для адмін-команди /ркон <команда>).
RCON_URL=ws://127.0.0.1:28016/ПАРОЛЬ_RCON

# ============================================================
# Сайт (server.js) — лише якщо запускаєш веб-сервер лідерборду
# ============================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NODE_VERSION=22
TRUST_PROXY=1
